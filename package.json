{
  "name": "gcpshot",
  "version": "0.7.0",
  "description": "GCPShot - captura de tela premium da Gestão Cultural Pro.",
  "main": "out/main/index.js",
  "author": "Gestão Cultural Pro",
  "homepage": "https://www.gestaoculturalpro.com.br",
  "private": true,
  "desktopName": "gcpshot.desktop",
  "scripts": {
    "test": "node scripts/test-colors.cjs && node scripts/test-branding-unit.cjs && node scripts/test-shortcuts-measurement.cjs",
    "build:brand": "node scripts/build-brand-assets.cjs",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-live-picker.cjs && npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:linux": "npm run build && electron-builder --linux deb --publish never"
  },
  "build": {
    "appId": "br.com.gestaoculturalpro.gcpshot",
    "productName": "GCPShot",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": true,
      "artifactName": "GCPShot-${version}-Windows-x64.${ext}",
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "GCPShot.ico"
        },
        {
          "from": "build/GCPShot.LiveColor.exe",
          "to": "GCPShot.LiveColor.exe"
        }
      ],
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "identity": "-",
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "minimumSystemVersion": "14.0",
      "target": [
        "dmg"
      ],
      "artifactName": "GCPShot-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "build/GCPShot.LiveColor",
          "to": "GCPShot.LiveColor"
        }
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "GCPShot precisa acessar a tela para capturas e selecao de cores.",
        "NSMicrophoneUsageDescription": "GCPShot usa o microfone quando voce habilita audio nas gravacoes.",
        "NSCameraUsageDescription": "GCPShot usa a camera quando voce habilita a webcam nas gravacoes."
      }
    },
    "linux": {
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "GCPShot",
          "StartupWMClass": "gcpshot",
          "Actions": "ColorLab;LiveColor;"
        },
        "desktopActions": {
          "ColorLab": {
            "Name": "Color Lab",
            "Exec": "\"/opt/GCPShot/gcpshot\" --color-lab",
            "Icon": "gcpshot"
          },
          "LiveColor": {
            "Name": "Live Color",
            "Exec": "\"/opt/GCPShot/gcpshot\" --live-color",
            "Icon": "gcpshot"
          }
        }
      },
      "icon": "build/icons",
      "category": "Graphics",
      "target": [
        "deb",
        "rpm"
      ],
      "artifactName": "GCPShot-${version}-Linux-${arch}.${ext}",
      "maintainer": "Gestao Cultural Pro <contato@gestaoculturalpro.com.br>",
      "extraResources": [
        {
          "from": "build/GCPShot.LiveColor",
          "to": "GCPShot.LiveColor"
        }
      ]
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "window": {
        "width": 660,
        "height": 420
      },
      "iconSize": 108,
      "iconTextSize": 13,
      "contents": [
        {
          "x": 180,
          "y": 240,
          "type": "file"
        },
        {
          "x": 480,
          "y": 240,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GCPShot"
    }
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-image-crop": "^11.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
